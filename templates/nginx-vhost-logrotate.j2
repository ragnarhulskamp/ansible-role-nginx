{{ nginx_www_root }}/*/logs/*.log {
    size {{ nginx_vhost_logrotate_min_size }}
    rotate {{ nginx_vhost_logrotate_rotate }}
    compress
    delaycompress
    missingok
    notifempty
    create 0644 {{ nginx_user }} {{ nginx_user }}
    sharedscripts
    postrotate
        /bin/kill -USR1 `cat {{ nginx_pidfile }} 2>/dev/null` 2>/dev/null || true
    endscript
}
