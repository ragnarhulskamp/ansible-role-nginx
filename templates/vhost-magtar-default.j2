{% block server_redirect %}
{% set listen_value = item.listen | default('80') %}
{% set enable_http_redirect = item.redirect_http_to_https | default('443' in listen_value) | bool %}
{% if enable_http_redirect and item.server_name is defined %}
server {
    listen       80;
    listen       [::]:80;
    server_name  {{ item.server_name }};
    return       301 https://$server_name$request_uri;
}
{% endif %}
{% if item.server_name_redirect is defined %}
server {
    listen       {{ item.listen | default('80') }};
    server_name  {{ item.server_name_redirect }};
    return       301 $scheme://{{ item.server_name.split(' ')[0] }}$request_uri;
}
{% endif %}
{% endblock %}

server {

    listen {{ item.listen | default('80') }};
{% if item.listen6 is defined %}
    listen {{ item.listen6 }};
{% endif %}
{% if item.server_name is defined %}
    server_name {{ item.server_name }};
{% endif %}
{% set root_path = item.root | default((nginx_www_root | default('/srv/www')) ~ '/' ~ item.server_name.split(' ')[0] ~ '/public_html') %}
    root {{ root_path }};
    index {{ item.index | default('index.html index.htm') }};
{% if item.error_page is defined %}
    error_page {{ item.error_page }};
{% endif %}

    access_log {{ nginx_www_root | default('/srv/www') }}/{{ item.server_name.split(" ")[0] }}/logs/access.log;
    error_log {{ nginx_www_root | default('/srv/www') }}/{{ item.server_name.split(" ")[0] }}/logs/error.log;

{% if item.php | default(false) | bool %}
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        {% set listen = php_fpm_listen | default('/run/php-fpm/www.sock') %}
        fastcgi_pass {{ listen if listen is match('^(unix:|[a-zA-Z]+://|[^/]+:[0-9]+)') else 'unix:' ~ listen }};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
{% endif %}

{% if item.standard_ssl | default(false) | bool %}
    # Default to Lego-issued certificates
    ssl_certificate     /etc/pki/tls/lego/certificates/{{ item.cert_name }}.pem;
    ssl_certificate_key /etc/pki/tls/lego/certificates/{{ item.cert_name }}.key;
    ssl_protocols       {{ nginx_ssl_protocols }};
    ssl_ciphers         {{ nginx_ssl_ciphers }};
{% endif %}

{% if item.extra_parameters is defined %}
    {{ item.extra_parameters|indent(4) }}
{% endif %}
}
