{% block server_redirect %}
{% if item.server_name_redirect is defined %}
server {
    listen       {{ item.listen | default('80') }};
    server_name  {{ item.server_name_redirect }};
    return       301 $scheme://{{ item.server_name.split(' ')[0] }}$request_uri;
}
{% endif %}
{% endblock %}

server {

    listen {{ item.listen | default('80') }};
{% if item.listen6 is defined %}
    listen {{ item.listen6 }};
{% endif %}
{% if item.server_name is defined %}
    server_name {{ item.server_name }};
{% endif %}
{% if item.root is defined %}
    root {{ item.root }};
{% endif %}
    index {{ item.index | default('index.html index.htm') }};
{% if item.error_page is defined %}
    error_page {{ item.error_page }};
{% endif %}

    access_log /srv/www/{{ item.server_name.split(" ")[0] }}/logs/access.log;
    error_log /srv/www/{{ item.server_name.split(" ")[0] }}/logs/error.log;

{% if item.php is defined %}
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php5-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
{% endif %}

{% if item.standard_ssl is defined %}
    ssl_certificate     /etc/pki/tls/certs/LetsEncryptCert-{{ item.cert_name }}.pem;
    ssl_certificate_key /etc/pki/tls/private/LetsEncryptCert-{{ item.cert_name }}.key;
    ssl_protocols       TLSv1.1 TLSv1.2;
    ssl_ciphers         HIGH:!aNULL:!MD5;
{% endif %}

{% if item.extra_parameters is defined %}
    {{ item.extra_parameters|indent(4) }}
{% endif %}
}
